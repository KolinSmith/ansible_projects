# Aggressive log rotation for Orange Pi to minimize storage usage
# Managed by Ansible - orangepi_disable_ramlog role

/var/log/syslog
/var/log/auth.log
/var/log/kern.log
/var/log/daemon.log
/var/log/user.log
/var/log/mail.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
    daily
    rotate {{ orangepi_log_rotation_days }}
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

# Reduce atop data retention
/var/log/atop/atop_*
{
    daily
    rotate {{ orangepi_atop_retention_days }}
    missingok
    notifempty
    compress
    delaycompress
}

# NOTE: sysstat is NOT logrotate'd here. sysstat manages its own rotation
# natively via /etc/cron.d/sysstat (debian-sa1) using HISTORY= in
# /etc/sysstat/sysstat. A previous version of this stanza logrotate'd
# /var/log/sysstat/* on top of that, and the glob matched sysstat's own
# already-rotated/compressed output, causing indefinite compounding
# rename corruption (e.g. sa01.1.1.1.1.1.2.gz.2.gz.1...) that exhausted
# the filesystem's inode table. Do not re-add a logrotate stanza for
# this directory — adjust HISTORY in /etc/sysstat/sysstat instead.