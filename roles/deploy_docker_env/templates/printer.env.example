# Print server Docker environment
# Managed by Ansible - Generated: {{ ansible_date_time.iso8601 }}

# Beszel agent (listen mode; reports to the hub on voyager :45876)
BESZEL_AGENT_KEY={{ docker_beszel_agent_key }}

# CUPS web-UI / lpadmin admin login (http://printserver:631)
CUPS_ADMIN_USER={{ docker_cups_admin_user | default('print') }}
CUPS_ADMIN_PASSWORD={{ docker_cups_admin_password }}

# Declarative print queue — the cups-samba image creates it on first start
PRINTER_NAME={{ docker_printer_name }}
PRINTER_URI={{ docker_printer_uri }}
PRINTER_PPD={{ docker_printer_ppd }}
