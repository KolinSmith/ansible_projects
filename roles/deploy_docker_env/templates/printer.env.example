# Print server Docker environment
# Managed by Ansible - Generated: {{ ansible_date_time.iso8601 }}

# Beszel Agent (reports to the hub on voyager)
# NOTE: fleet-shared secrets from the Beszel hub deployment. If the hub is
# rebuilt, regenerate these in its web UI and update vault.yml.
BESZEL_AGENT_TOKEN={{ docker_beszel_agent_token }}
BESZEL_AGENT_KEY={{ docker_beszel_agent_key }}

# CUPS admin login for the web UI at http://printserver:631
CUPS_ADMIN_USER={{ docker_cups_admin_user | default('print') }}
CUPS_ADMIN_PASSWORD={{ docker_cups_admin_password }}
