# Voyager Docker Environment Variables
# Managed by Ansible - Generated: {{ ansible_date_time.iso8601 }}

# Beszel Agent Configuration
# NOTE: These secrets are unique to the Beszel hub deployment
# If you redeploy the hub from scratch, regenerate these in the web UI
# and update vault.yml with new values
BESZEL_AGENT_TOKEN={{ docker_beszel_agent_token }}
BESZEL_AGENT_KEY={{ docker_beszel_agent_key }}

# Legacy - Capture (commented out in docker-compose.yml)
# CAPTURE_API_SECRET={{ docker_capture_api_secret }}

# Hermes Agent (primary AI interface, replaces Claude Code)
ANTHROPIC_API_KEY={{ docker_hermes_anthropic_api_key }}
TELEGRAM_BOT_TOKEN={{ docker_hermes_telegram_bot_token }}

# Mem0 (Hermes's external memory provider, self-hosted)
# ADMIN_API_KEY and JWT_SECRET are NOT third-party credentials -- generate
# locally with `openssl rand -hex 32` and store in vault like any other secret.
MEM0_POSTGRES_PASSWORD={{ docker_mem0_postgres_password }}
MEM0_ADMIN_API_KEY={{ docker_mem0_admin_api_key }}
MEM0_JWT_SECRET={{ docker_mem0_jwt_secret }}
# Mem0's bundled default embedder (text-embedding-3-small) is OpenAI-only --
# Anthropic has no embedding models. This key is used ONLY for embeddings;
# Mem0's own internal LLM calls can still use ANTHROPIC_API_KEY above.
MEM0_OPENAI_API_KEY={{ docker_mem0_openai_api_key }}
